# ---------------------------------------------------------------
# Achrat Exports environment variables (copy to .env for local dev)
# The site itself is fully static; ONLY the enquiry form needs these.
# ---------------------------------------------------------------

# --- SMTP (choose ONE provider: Gmail App Password, Zoho, or any SMTP) ---
EMAIL_PROVIDER="smtp"                 # "smtp" (default) or "resend"
SMTP_HOST="smtp.gmail.com"            # Zoho: smtp.zoho.com | Outlook: smtp.office365.com
SMTP_PORT="465"                       # 465 (SSL) or 587 (STARTTLS)
SMTP_USER="your-business-email@gmail.com"
SMTP_PASS="your-16-char-app-password" # Gmail: Google Account → Security → App Passwords
MAIL_FROM="Achrat Exports <your-business-email@gmail.com>"
MAIL_TO="sales@achratexports.com"     # inbox that receives enquiries

# --- Alternative: Resend (set EMAIL_PROVIDER="resend") ---
# RESEND_API_KEY="re_xxxxxxxxxxxx"

# --- Public site settings ---
NEXT_PUBLIC_SITE_URL="https://achratexports.com"
NEXT_PUBLIC_WHATSAPP="919999999999"   # digits only, with country code. REPLACE
NEXT_PUBLIC_PHONE="+91 99999 99999"   # REPLACE
NEXT_PUBLIC_EMAIL="sales@achratexports.com" # REPLACE
# NEXT_PUBLIC_IEC=""                    # IEC code when issued
# NEXT_PUBLIC_INSTAGRAM=""              # full profile URL
# NEXT_PUBLIC_LINKEDIN=""
# NEXT_PUBLIC_FACEBOOK=""
# NEXT_PUBLIC_YOUTUBE=""

# --- Optional: Cloudflare Turnstile spam protection (free) ---
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAA..."
# TURNSTILE_SECRET_KEY="0x4AAAAAAA..."
